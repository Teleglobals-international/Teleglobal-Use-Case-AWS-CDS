# Copy relevant values into the repo-root .env (NOT this file).
# The app reads the .env at the repository root.

# --- AWS core ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-account-id

# --- Bedrock model ---
LLM_PROVIDER=bedrock
LLM_MODEL=apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Optional: real Bedrock Knowledge Base (else local corpus is used) ---
KNOWLEDGE_BASE_ID=

# --- Amazon Cognito (user auth). Leave empty to use the in-memory fallback. ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Channels: false = live sending via SES (default); true = local simulation ---
SIMULATE_CHANNELS=false

# --- SES (email). Use an SES-verified sender in your AWS region. ---
SES_FROM_EMAIL=your-verified-sender@example.com
SES_CONFIGURATION_SET=
ADVISOR_ALERT_EMAIL=advisor@example.com

# --- Optional: WhatsApp via AWS End User Messaging Social ---
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional: DynamoDB hand-off queue ---
HANDOFF_TABLE=mf-advisor-handoff-queue
