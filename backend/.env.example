# Copy relevant values into the repo-root .env (NOT this file).
# The app reads the .env at the repository root.

# --- AWS core ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your-account-id

# --- Bedrock model ---
LLM_PROVIDER=bedrock
LLM_MODEL=apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Optional: real Bedrock Knowledge Base (else local corpus is used) ---
KNOWLEDGE_BASE_ID=

# --- Channels: keep true for local demo; false to send real messages ---
SIMULATE_CHANNELS=true

# --- Optional: SES (email) ---
SES_FROM_EMAIL=assistant@axismf.example
SES_CONFIGURATION_SET=
ADVISOR_ALERT_EMAIL=advisor@axismf.example

# --- Optional: WhatsApp via AWS End User Messaging Social ---
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional: DynamoDB hand-off queue ---
HANDOFF_TABLE=mf-advisor-handoff-queue
